# Copy to .env.local (git-ignored) and adjust for your machine.
# Only variables prefixed with VITE_ are exposed to the browser bundle —
# never put secrets in them.

# Base URL of the TaskFlow REST API. Either:
#  - a same-origin path (recommended): "/api/v1", served by the dev proxy below in
#    development and by a reverse proxy in production — no CORS configuration; or
#  - an absolute URL, e.g. "https://api.example.com/api/v1" (the backend must then
#    allow this app's origin via CORS, including for the /events SSE stream).
VITE_API_BASE_URL=/api/v1

# Development only: where the Vite dev server forwards /api requests
# (the Spring Boot backend). Not exposed to the browser.
API_PROXY_TARGET=http://localhost:8080

# Request timeout for API calls, in milliseconds
VITE_API_TIMEOUT_MS=15000

# How often (ms) pages refresh while live updates (SSE) are unavailable
VITE_POLL_INTERVAL_MS=5000

# Development only: answer API requests with MSW mocks (src/mocks) instead of a
# real backend. Ignored in production builds.
VITE_ENABLE_API_MOCKS=false
