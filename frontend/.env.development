# Defaults for `npm run dev`. Override locally in .env.development.local (git-ignored).

# Same-origin path: the Vite dev server proxies /api to API_PROXY_TARGET (no CORS needed).
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://localhost:8080

VITE_API_TIMEOUT_MS=15000
VITE_POLL_INTERVAL_MS=5000

# Answer API calls with in-browser mocks (src/mocks) until the backend exists.
# Set to false (in .env.development.local) to use the Spring Boot backend.
VITE_ENABLE_API_MOCKS=true
